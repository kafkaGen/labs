{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "bootstrap-sha": "316148bf591b9a67656d550022253aa94e99ec76",
  "packages": {
    "packages/labs-logging": {
      "component": "labs-logging",
      "package-name": "labs-logging",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='labs-logging')].version"
        }
      ]
    },
    "packages/weather-agents": {
      "component": "weather-agents",
      "package-name": "weather-agents",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='weather-agents')].version"
        }
      ]
    }
  }
}
